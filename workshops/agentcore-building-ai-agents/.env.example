# AgentCore agent template — environment variables for local development
#
# Copy to .env and fill in only the services you have deployed. Every variable
# is optional: an unset ID disables that feature instead of failing, so you can
# run the agent locally before `terraform apply` has created everything.
#
#   cp .env.example .env && make run-agent-locally

# --- AgentCore Memory -------------------------------------------------------
# From tmp/memory_id.txt after deploy. Unset: no cross-session memory.
MEMORY_ID=
# Defaults to DEFAULT_ACTOR_ID in src/agent/agent_config.py.
# In production, derive this from the authenticated user identity.
ACTOR_ID=

# --- Bedrock Knowledge Base -------------------------------------------------
# From tmp/knowledge_base_id.txt after deploy. Unset: no RAG tool.
KNOWLEDGE_BASE_ID=

# --- AgentCore Gateway (MCP tools) ------------------------------------------
# From tmp/gateway_url.txt after deploy. Unset: no MCP tools are loaded.
GATEWAY_URL=
COGNITO_SCOPE=

# --- AgentCore Identity -----------------------------------------------------
# Used by the deployed runtime to fetch a Gateway token automatically.
WORKLOAD_ID_NAME=
CREDENTIAL_PROVIDER_NAME=

# --- Cognito M2M (local runs only) ------------------------------------------
# Locally there is no WorkloadIdentity, so the agent falls back to a direct
# client-credentials grant. Leave unset when running on AgentCore Runtime.
COGNITO_TOKEN_ENDPOINT=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# --- Remote invocation ------------------------------------------------------
# Set to call a deployed runtime from remote_agent_invoker.py instead of
# running the agent in-process. From tmp/agent_runtime_url.txt after deploy.
AGENTCORE_RUNTIME_URL=
